{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowJs": true,
    "paths": {
      "react-dom": [
        "./packages/react-dom/src/index.ts"
      ],
      "react-dom/client": [
        "./packages/react-dom/src/client.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "examples/*/src"
  ]
}
